!------------------------------------------------------------------------------------
! This script runs the IEEE 34 Bus test case (Mod 1)
!------------------------------------------------------------------------------------

! change the path name to match where it is actually installed on your computer

Clear

Compile ieee34Mod1_no_reg.dss

New Energymeter.M1  Line.L1  1

Batchedit RegControl..* maxtapchange=0

Redirect Pvsystem.dss

!set controlmode=off
set MaxIterations=200

Solve mode=snapshot

set LoadModel=Admittance

new monitor.mon_pv_current element=pvsystem.pv1 terminal=1 mode=0

solve mode=dynamics number=1 stepsize=0.001


New Fault.falta phases=3 bus=850 r=0.001
solve number=50

!solve
!Buscoords IEEE34_BusXY.csv

!Show voltage LN Nodes
!Show currents element
!show powers kva element
!show taps
